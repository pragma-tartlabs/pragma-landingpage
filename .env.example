# Supabase Configuration
# Public URLs/keys safe for frontend (ANON_KEY allows read/insert only, rate-limited)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only (service role key has full admin access, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ConvertKit Configuration
# API key is server-side only (used for automations and subscriber management)
CONVERTKIT_API_KEY=your-convertkit-api-key-here
CONVERTKIT_FORM_ID=your-form-id-here

# Application Configuration
VITE_SITE_URL=http://localhost:5173
VITE_APP_ENV=development
